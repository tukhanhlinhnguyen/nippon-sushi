---
import '../styles/global.css'; // Adjust the relative path to match your global.css location
import { Image } from 'astro:assets';
import logoNavImage from '../assets/images/logo.png';
import logoFootImage from '../assets/images/logo.png';
import favicon from "../assets/images/logo.png";
const { title } = Astro.props;
const instaURL = "https://www.instagram.com/lenipponsushis_aubagne/"
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Restaurant asiatique - JAPANESE Cuisines & Sushi Bar à Aubagne" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital@0;1&family=Raleway:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#1F2030] text-slate-100 font-['Raleway'] antialiased">
    
    <!-- REUSABLE NAVIGATION BAR -->
    <nav class="fixed w-full z-50 bg-[#1F2030]/95 backdrop-blur-md border-b border-slate-800 p-1 transition-all">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <!-- Logo (Goes Home) -->
        <a href="/" class="inline-block">
          <Image
            src={logoNavImage}
            alt="Nippon Sushi"
            class="w-auto h-10 object-contain"
            />
        </a>

        <!-- Desktop Links -->
        <ul class="hidden lg:flex gap-8 text-sm uppercase tracking-wider font-medium text-slate-300">
          <li><a href="/" class="hover:text-[#cf2929] transition-colors">Accueil</a></li>
          <li><a href="/menu-emporter" class="hover:text-[#cf2929] transition-colors">Menu emporter</a></li>
          <li><a href="/mentions-legales" class="hover:text-[#cf2929] transition-colors">Mentions légales</a></li>
          <li><a href="/cg" class="hover:text-[#cf2929] transition-colors">CGU</a></li>
          <li><a href="/cgv" class="hover:text-[#cf2929] transition-colors">CGV</a></li>
        </ul>

        <!-- CTA & Mobile -->
        <div class="flex items-center gap-4">
          <a href="tel:0759399607" class="hidden sm:inline-block bg-[#cf2929] text-white px-6 py-2 text-sm font-bold uppercase tracking-wider hover:bg-red-700 transition">
            07 59 39 96 07
          </a>
          <button class="lg:hidden text-white text-2xl p-2">
            &#9776; 
          </button>
        </div>
      </div>
    </nav>

    <!-- PAGE CONTENT INJECTED HERE -->
    <main>
      <slot />
    </main>

    <!-- REUSABLE FOOTER -->
    <footer class="bg-[#151623] text-white border-t-2 border-[#cf2929]">

      <div class="max-w-7xl mx-auto px-5 md:px-8 py-14 md:py-16">
    
        <!-- TOP -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16">
    
          <!-- BRAND -->
          <div class="md:col-span-4">

            <!-- LOGO -->
            <!-- <a href="/" class="inline-block mb-6">
              <Image
                src={logoFootImage}
                alt="Nippon Sushi"
                class="w-48 md:w-56 h-auto object-contain"
              />
            </a> -->

            <p class="text-[#cf2929] text-xs font-bold uppercase tracking-[0.3em] mb-3">
              Restaurant Japonais
            </p>

            <h2 class="font-serif text-3xl md:text-4xl font-normal leading-tight mb-5">
              Cuisine japonaise
              <br />
              <span class="text-slate-400">& Sushi Bar</span>
            </h2>

            <p class="text-slate-400 text-sm leading-relaxed max-w-sm mb-7">
              Découvrez notre cuisine japonaise préparée avec des produits frais,
              à déguster sur place ou à emporter à Aubagne.
            </p>

            <a
              href="tel:0759399607"
              class="inline-flex items-center gap-3 text-xl font-bold text-white hover:text-[#cf2929] transition-colors"
            >
              <span class="text-[#cf2929]">Tel</span>
              07 59 39 96 07
            </a>

            <a
              href={instaURL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram Nippon Sushi"
              class="inline-flex items-center gap-3 mt-6 px-5 py-3 rounded-lg border border-slate-700 text-slate-300 hover:text-white hover:border-[#cf2929] hover:bg-[#cf2929]/10 transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="w-5 h-5"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
              </svg>

              <span class="text-sm font-semibold">
                Suivez-nous sur Instagram
              </span>
            </a>
          </div>

          <!-- HOURS / ADDRESS -->
          <div class="md:col-span-4">
    
            <h3 class="font-serif text-2xl text-white mb-6">
              Informations
            </h3>
    
            <div class="space-y-6">
    
              <!-- ADDRESS -->
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-[#cf2929] font-bold mb-2">
                  Adresse
                </p>
    
                <p class="text-slate-300 text-sm leading-relaxed">
                  40 Av. des Goums
                  <br />
                  13400 Aubagne, France
                </p>
              </div>
    
    
              <!-- HOURS -->
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-[#cf2929] font-bold mb-2">
                  Horaires
                </p>
    
                <p class="text-white font-semibold">
                  Tous les jours
                </p>
    
                <p class="text-slate-400 text-sm mt-1">
                  18:30 — 23:30
                </p>
              </div>
    
            </div>
    
          </div>
    
    
          <!-- MAP -->
          <div class="md:col-span-4">
    
            <div class="flex items-center justify-between mb-5">
    
              <h3 class="font-serif text-2xl text-white">
                Nous trouver
              </h3>
    
              <a
                href="https://www.google.com/maps/search/?api=1&query=Nippon+Sushi+Aubagne"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs uppercase tracking-wider text-[#cf2929] hover:text-white transition-colors"
              >
                Itinéraire →
              </a>
    
            </div>
    
            <div class="h-72 md:h-80 lg:h-96 bg-slate-800 rounded-xl overflow-hidden border border-slate-700 shadow-2xl">
              <iframe
                src="https://maps.google.com/maps?q=nippon%20sushi%20aubagne&t=m&z=14&output=embed"
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                title="Google Map Nippon Sushi Aubagne"
              ></iframe>
            </div>
    
          </div>
    
        </div>
    
    
        <!-- BOTTOM -->
        <div class="mt-14 pt-7 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4">
    
          <p class="text-xs text-slate-500 text-center md:text-left">
            © 2026 Le Nippon Sushi. Tous droits réservés.
          </p>
    
          <p class="text-xs text-slate-500">
            Site réalisé par
            <a
              href="https://societe-kali.fr/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-[#cf2929] transition-colors font-medium"
            >
              KALI
            </a>
          </p>
    
        </div>
    
      </div>
    
    </footer>

  </body>
</html>

<style is:global>
  h1, h2, h3, h4, h5, h6 { font-family: 'EB Garamond', serif; }
</style>