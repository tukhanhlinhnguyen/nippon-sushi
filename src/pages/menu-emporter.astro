---

<Layout title="Menu à emporter - Nippon Sushi">
  
  <!-- HEADER SECTION -->
  <section class="pt-32 pb-16 bg-[#151623] text-center border-b border-[#cf2929] px-6">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl font-bold text-white mb-6">Menu à emporter</h1>
      
      <div class="bg-[#cf2929]/10 border border-[#cf2929] rounded-lg p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl text-[#cf2929] font-bold mb-4 uppercase tracking-wide">1 acheté = 1 offert !</h2>
        <p class="text-slate-300 text-lg mb-6">Pour tout achat à emporter, vous bénéficiez de notre offre spéciale.</p>
        <a href="tel:0759399607" class="inline-block bg-[#cf2929] text-white px-8 py-3 font-bold uppercase tracking-widest rounded hover:bg-red-700 transition shadow-lg">
          Commander au 07 59 39 96 07
        </a>
      </div>
    </div>
  </section>

  <!-- FORMULES ACHETÉ = 1 OFFERT -->
  <section class="py-20 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-white mb-2">Formules</h2>
      <h3 class="text-2xl text-[#cf2929] italic">1 Acheté = 1 Offert</h3>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {formulesAcheteOffert.map((formule) => (
        <div class="bg-[#1F2030] p-6 rounded-lg border border-slate-700 shadow-lg">
          <div class="flex justify-between items-start mb-4 border-b border-slate-800 pb-4">
            <div>
              <h4 class="text-xl font-bold text-white">{formule.name}</h4>
              <span class="text-sm text-slate-400">{formule.items}</span>
            </div>
            <span class="text-xl font-bold text-[#cf2929]">{formule.price}</span>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">{formule.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FORMULES CLASSIQUES -->
  <section class="py-12 px-6 max-w-5xl mx-auto border-t border-slate-800">
    <div class="grid md:grid-cols-2 gap-8">
      {formulesClassiques.map((formule) => (
        <div class="bg-[#2a2b3d] p-6 rounded-lg border border-slate-700 shadow-lg">
          <div class="flex justify-between items-start mb-4 border-b border-slate-700 pb-4">
            <div>
              <h4 class="text-xl font-bold text-white">{formule.name}</h4>
              <span class="text-sm text-slate-400">{formule.items}</span>
            </div>
            <span class="text-xl font-bold text-[#cf2929]">{formule.price}</span>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">{formule.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PLATEAUX -->
  <section class="py-20 px-6 bg-[#151623]">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-12">Nos Plateaux</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {plateaux.map((plateau) => (
          <div class="bg-[#1F2030] p-5 rounded border border-slate-800 flex justify-between gap-4 group hover:border-[#cf2929] transition-colors">
            <div>
              <h4 class="text-white font-bold mb-1">{plateau.code} <span class="text-slate-400 font-normal">| {plateau.name}</span></h4>
              <p class="text-slate-400 text-xs leading-relaxed">{plateau.desc}</p>
            </div>
            <div class="text-[#cf2929] font-bold whitespace-nowrap">{plateau.price}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- A LA CARTE (Variable quantities) -->
  <section class="py-20 px-6 max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold text-center text-white mb-12">À la Carte</h2>
    <div class="grid md:grid-cols-3 gap-8 mb-12">
      {aLaCarte.map((category) => (
        <div class="bg-[#2a2b3d] p-6 rounded-lg border border-slate-700">
          <h4 class="text-2xl text-white mb-2 font-bold text-center">{category.category}</h4>
          <p class="text-[#cf2929] text-sm font-bold text-center mb-1">{category.pricing}</p>
          {category.note && <p class="text-slate-400 text-xs text-center italic mb-4">{category.note}</p>}
          <div class="border-t border-slate-700 mt-4 pt-4">
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li class="text-slate-300 text-sm flex items-start gap-2">
                  <span class="text-[#cf2929] mt-1">▸</span> {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- SPECIALITES (Fixed prices) -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {specialites.map((category) => (
        <div class="bg-[#1F2030] p-6 rounded-lg border border-slate-800">
          <h4 class="text-2xl text-white mb-4 border-b border-slate-800 pb-2 font-bold">{category.category}</h4>
          {category.note && <p class="text-slate-400 text-xs italic mb-4">{category.note}</p>}
          <ul class="space-y-4">
            {category.items.map((item) => (
              <li class="flex flex-col">
                <div class="flex justify-between text-slate-200">
                  <span class="font-medium">{item.name}</span>
                  <span class="text-[#cf2929] font-bold">{item.price}</span>
                </div>
                {item.desc && <span class="text-slate-500 text-xs">{item.desc}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ROLLS (Maki, California, Snow, Dragon) -->
  <section class="py-20 px-6 bg-[#151623]">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {rolls.map((category) => (
          <div class="bg-[#1F2030] p-6 rounded-lg border border-slate-800">
            <h4 class="text-2xl text-white mb-6 border-b border-slate-800 pb-2 font-bold">{category.category}</h4>
            <ul class="space-y-3">
              {category.items.map((item) => (
                <li class="flex justify-between items-center text-slate-300 border-b border-slate-800/50 pb-2 last:border-0">
                  <span class="text-sm pr-4">{item.name}</span>
                  <span class="text-[#cf2929] font-bold whitespace-nowrap">{item.price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      
      <!-- BOISSONS -->
      <div class="mt-12 text-center bg-[#2a2b3d] p-8 rounded-lg border border-slate-700">
        <h4 class="text-2xl text-white font-bold mb-4">Boissons</h4>
        <p class="text-slate-300">Coca-cola, Coca-cola zero, Fanta, Ice Tea, Orangina, Bière Asahi</p>
      </div>
    </div>
  </section>

</Layout>